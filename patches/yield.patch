--- a/src/codal_app/microbithal.cpp
+++ b/src/codal_app/microbithal.cpp
@@ -85,10 +85,22 @@ void microbit_hal_background_processing(void) {
-    // This call takes about 200us.
+    // Fire the idle event (~200 us) then actually yield CPU to other fibers.
+    // Without the schedule() call the robot-kernel fiber gets ZERO CPU while
+    // Python runs -- the event fires handlers registered on the message bus
+    // but never does a CODAL context switch.
     Event(DEVICE_ID_SCHEDULER, DEVICE_SCHEDULER_EVT_IDLE);
+    schedule();
 }
 
 void microbit_hal_idle(void) {
-    microbit_hal_background_processing();
-    __WFI();
+    // Replace the busy-wait (WFI) with a fiber_sleep so Python's sleep()
+    // and any blocking in mp_hal_delay_ms() cooperatively yields to the
+    // kernel fiber.  fiber_sleep(1) is the minimum; it yields for at least
+    // one scheduler tick (~1 ms) and returns after the fiber is woken.
+    fiber_sleep(1);
+    microbit_hal_background_processing();
 }
